# -----------------------------------------------------------------------------
# PlanMyStay.in Production Environment Variables
# -----------------------------------------------------------------------------
# Add your legitimate API credentials below to activate real live bookings.
# Never commit real secret keys to source control.
# -----------------------------------------------------------------------------

# 1. FLIGHTS API (Amadeus Self-Service or Enterprise)
# Register at: https://developers.amadeus.com
AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""

# 2. HOTELS API (Authorized Hotel GDS / Booking API Provider)
# Amadeus Hotel Search, Booking.com Partner API, or Hotelbeds
HOTEL_API_KEY=""

# 3. BUSES API (Authorized Bus Aggregator API)
# RedBus Developer Platform or AbhiBus B2B Gateway
BUS_API_KEY=""

# 4. TRAINS API (Authorized Railway Gateway / IRCTC Partner)
# IRCTC Principal Service Provider (PSP) or Authorized Indian Rail Partner API
TRAIN_API_KEY=""

# 5. PAYMENTS GATEWAY (Razorpay - RBI Authorized)
# Register at: https://dashboard.razorpay.com -> Settings -> API Keys
# Test keys start with "rzp_test_", Live keys start with "rzp_live_"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# 6. RELATIONAL DATABASE & SUPABASE
# Connection URI: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=""
# Supabase Project URL & Keys (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# 7. AI CONCIERGE (Google Gemini 3.8 Flash - Optional)
GEMINI_API_KEY=""

# 8. DJANGO BACKEND & VERCEL INTEGRATION
# Base URL of the deployed Django REST API (e.g. on Render or Railway)
VITE_API_BASE_URL="https://api.planmystay.in"
DJANGO_BACKEND_URL="https://api.planmystay.in"

# 9. APP DEPLOYMENT URL
APP_URL="https://planmystay.in"
