# -----------------------------------------------------------------------------
# PlanMyStay.in Django Production Environment Configuration
# -----------------------------------------------------------------------------
# Copy this file to .env in your hosting environment (e.g. Render, Railway, AWS).
# Never commit the .env file containing real secrets to version control.
# -----------------------------------------------------------------------------

# 1. CORE DJANGO CONFIGURATION
DEBUG=False
SECRET_KEY=django-insecure-replace-with-a-cryptographically-random-50-character-secret-key-in-production
ALLOWED_HOSTS=api.planmystay.in,planmystay-backend.onrender.com,localhost,127.0.0.1

# 2. CORS & FRONTEND DOMAINS
# Comma-separated frontend domains permitted to call the API
CORS_ALLOWED_ORIGINS=https://planmystay.in,https://planmystay.vercel.app,http://localhost:3000,http://localhost:5173

# 3. DATABASE (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://planmystay_user:secure_password@postgres.render.com:5432/planmystay_db?sslmode=require

# 4. RAZORPAY PAYMENT GATEWAY (RBI Authorized)
# Test keys start with "rzp_test_", Live production keys start with "rzp_live_"
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=yourRazorpayWebhookSecretHere

# 5. TRAVEL INTEGRATIONS (Optional for live third-party inventory)
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret
HOTEL_API_KEY=your_hotel_api_key
TRAIN_API_KEY=your_train_api_key
BUS_API_KEY=your_bus_api_key

# 6. AI CONCIERGE (Optional Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# 7. PRODUCTION SECURITY SETTINGS
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
